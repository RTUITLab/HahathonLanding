            element3: {
                number: "(0-2)",
                text: "Проработка геймплея и механик"
            },
            element4: {
                number: "(0-2)",
                text: "Звуковое сопровождение"
            },
            element5: {
                number: "(0-2)",
                text: "Визуальный стиль"
            },
            element6: {
                number: "(0-2)",
                text: "Социальные механики"
            },
            element7: {
                number: "(0-2)",
                text: "Игровой интерфейс"
            },
            element8: {
                number: "(1-3)",
