-
    var task_data = [{
        description: {
            text: "Придумайте и разработайте мобильную игру для Android в жанре <span>Разрушить замок</span>. Основная цель - создать проект, который сохраняет дух жанра, но добавляет необычные механики и идеи.\n\nМы приветствуем эксперименты с технологиями, будь то использование гироскопа, AR/VR, внедрение мультиплеера или оригинальных социальных взаимодействий.",
            explanation1: "Вы сами выбираете инструменты и технологии разработки - полный простор для креатива!",
            explanation2: "Игровая сессия не должна превышать 15 минут, чтобы игра оставалась динамичной и увлекательной.",
            explanation3: "Разрешается использовать сторонние ассеты только при условии, что они находятся в открытом доступе и соответствуют условиям свободного использования.",
            explanation4: "Финальная версия должна быть представлена в формате АРК и запускаться на Android-устройствах.",
        },
        genre: {
            text: "Игры в жанре <span>Разрушить замок</span> - это аркады, где игроку предлагается разрушить сооружения, используя различные устройства, такие как катапульты, пушки или арбалеты. Успех зависит от правильного расчёта силы и траектории удара.\n\nИзвестными представителями этого жанра являются <span>Angry Birds</span> и <span>Crash the Castles</span>.",
            element1: "<span>Ограниченные ресурсы</span> - определённое число попыток или снарядов.",
            element2: "<span>Физика разрушений</span> - убедительные и зрелищные столкновения и падения.",
            element3: "<span>Стратегия и зрелищность</span> - игра приносит удовольствие и заставляет выстраивать стратегию разрушений.",
        },
        order: {
            text: "Сдача решений происходит через форму, опубликованную в официальном чате <a target='_blank' href='https://t.me/vkrum_2024'>vkrum_2024</a> и отправленную на почту капитанам команд.\n\nИгровые проекты и сопровождающие материалы загружаются в виде ссылок на папку в облаке.",
            element1: "Видео демонстрации игры (3-6 минут), где будет показан геймплей и ключевые механики.",
            element2: "Видеопрезентация защиты проекта. Рассказ про идею, технические особенности и т.д.",
            element3: "Ссылку на репозиторий с исходным кодом",
            element4: "Игровой билд в формате APK",
