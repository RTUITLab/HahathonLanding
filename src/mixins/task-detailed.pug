mixin task-block(data)
    .description-block
        h3.task__block__header Постановка задачи

        .description__task__block
            .description__task__block__one
                .block__blue
                    p Описание
                .block__text
                    p = data.description.text
            .description__task__block__two
                .block__text
                    .block__blue__mini 01
                    p = data.description.explanation1
                .block__text
                    .block__blue__mini 02
                    p = data.description.explanation2
                .block__text
                    .block__blue__mini 03
                    p = data.description.explanation3
                .block__text
                    .block__blue__mini 04
                    p = data.description.explanation4

        h3.genre__block__header Больше о жанре

        .description__genre__block
            .description__genre__block__one
                .block__text
                    p = data.genre.text
            .description__order__block__two
                .block__blue
                    p Ключевые элементы
                .block__text
                    .block__blue__mini 01
                     p = data.genre.element1
                .block__text
                    .block__blue__mini 02
                    p = data.genre.element2
                .block__text
                    .block__blue__mini 03
                    p = data.genre.element3

        h3.order__block__header Порядок сдачи работ

        .description__order__block
            .description__order__block__one
                .block__text
                    p = data.order.text
                .block__blue__center
                    p Проверьте доступ к файлам перед указанием ссылок
            .description__order__block__two
                .block__text
                    .block__blue__mini 01
                    p = data.order.element1
                .block__text
                    .block__blue__mini 02
                    p = data.order.element2
                .block__text
                    .block__blue__mini 03
                    p = data.order.element3
                .block__text
                    .block__blue__mini 04
                    p = data.order.element4

        h3.estimation__block__header Оценка проектов

        .description__estimation__block
            .estimation__block
                p = data.estimation.element1.text
                h4 = data.estimation.element1.number
            .estimation__block
                p = data.estimation.element2.text
                h4 = data.estimation.element2.number
            .estimation__block
                p = data.estimation.element3.text
                h4 = data.estimation.element3.number
            .estimation__block
                p = data.estimation.element4.text
                h4 = data.estimation.element4.number
            .estimation__block
                p = data.estimation.element5.text
                h4 = data.estimation.element5.number
            .estimation__block
                p = data.estimation.element6.text
                h4 = data.estimation.element6.number
            .estimation__block
                p = data.estimation.element7.text
                h4 = data.estimation.element7.number
            .estimation__block
                p = data.estimation.element8.text
                h4 = data.estimation.element8.number
            .estimation__block
                p = data.estimation.element9.text
                h4 = data.estimation.element9.number
            .estimation__block
                p = data.estimation.element10.text
                h4 = data.estimation.element10.number

h2.text__header Задание
section#registration-section

section.task__detailed#task-detailed-section
    h2.task__detailed__header Задание

    .task__detailed__content
        each task in task_data
            +task-block(task)