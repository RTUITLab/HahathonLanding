-
  var prises_data = [
    {
      imgSrc:'assets/prises/Awards1.svg',
      width:'250px',
      height:'250px',
      alt:'Логотип VK',
      description: '150 000 рублей за первое место'
    },{
      imgSrc:'assets/prises/Awards2.svg',
      width:'250px',
      height:'250px',
      alt:'Деньги',
      description:'100 000 рублей за второе место'
    }, {
      imgSrc:'assets/prises/Awards3.svg',
      width:'250px',
      height:'250px',
      alt:'Логотип РТУ МИРЭА',
      description:'50 000 рублей за третье место'
    }] 
 
mixin prise-block(data)
  .prise-block
    img.logo(src=data.imgSrc width=data.width height=data.height alt=data.alt)
    p.description
      = data.description

section.prises#prises-section
  h2.prises__header Призы

  .prises__content
    each prise in prises_data
      +prise-block(prise)
