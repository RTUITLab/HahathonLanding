mixin task-block(data)
  .description-block
    h3.task__block__header Постановка задачи

    .description__task__block
      .description__task__block__one
        .block__blue
          p Описание
        .block__text
          p.description !{data.description.text}
      .description__task__block__two
        .pc__adaptive
          .column1
            .block__text
              .block__blue__mini 01
              p.description= data.description.explanation1
            .block__text
              .block__blue__mini 03
              p.description= data.description.explanation3
          .column2
            .block__text
              .block__blue__mini 02
              p.description= data.description.explanation2
            .block__text
              .block__blue__mini 04
              p.description= data.description.explanation4
        .mobile__adaptive
          .column1
            .block__text
              .block__blue__mini 01
              p.description= data.description.explanation1
            .block__text
              .block__blue__mini 02
              p.description= data.description.explanation2
            .block__text
              .block__blue__mini 03
              p.description= data.description.explanation3
            .block__text
              .block__blue__mini 04
              p.description= data.description.explanation4

    h3.genre__block__header Больше о жанре

    .description__genre__block
      .description__genre__block__one
        .block__text
          p.description !{data.genre.text}
      .description__genre__block__two
        .block__blue
          p Ключевые элементы
        .block__text
          .block__blue__mini 01
          p.description !{data.genre.element1}
        .block__text
          .block__blue__mini 02
          p.description !{data.genre.element2}
        .block__text
          .block__blue__mini 03
          p.description !{data.genre.element3}

    h3.order__block__header Порядок сдачи работ

    .description__order__block
      .description__order__block__one
        .block__text
          p.description !{data.order.text}
        .block__blue__center
          p Проверьте доступ к файлам перед указанием ссылок
      .description__order__block__two
        .block__text
          .block__blue__mini 01
          p.description= data.order.element1
        .block__text
          .block__blue__mini 02
          p.description= data.order.element2
        .block__text
          .block__blue__mini 03
          p.description= data.order.element3
        .block__text
          .block__blue__mini 04
          p.description= data.order.element4

    h3.estimation__block__header Оценка проектов

    .description__estimation__block
      .estimation__block
        p.description= data.estimation.element1.text
        h4.description= data.estimation.element1.number
      .estimation__block
        p.description= data.estimation.element2.text
        h4.description= data.estimation.element2.number
      .estimation__block
        p.description= data.estimation.element3.text
        h4.description= data.estimation.element3.number
      .estimation__block
        p.description= data.estimation.element4.text
        h4.description= data.estimation.element4.number
      .estimation__block
        p.description= data.estimation.element5.text
        h4.description= data.estimation.element5.number
      .estimation__block
        p.description= data.estimation.element6.text
        h4.description= data.estimation.element6.number
      .estimation__block
        p.description= data.estimation.element7.text
        h4.description= data.estimation.element7.number
      .estimation__block
        p.description= data.estimation.element8.text
        h4.description= data.estimation.element8.number
      .estimation__block
        p.description= data.estimation.element9.text
        h4.description= data.estimation.element9.number
      .estimation__block
        p.description= data.estimation.element10.text
        h4.description= data.estimation.element10.number

h2.text__header Задание
section#registration-section

  .task__detailed__content
    each task in task_data
      +task-block(task)

  form#register(name="form")
    h3 Заполните форму и укажите всех участников
    input(type="text" id="team-name" placeholder="Название команды *" minlength="3" required data-error="Необходимо указать название команды")
    input(type="number" id="team-length" placeholder="Количество участников *" min="2" max="5" required data-error="Количество участников должно быть от 2 до 5")

    button.button.g-recaptcha(type="submit" id="form-submit" data-size="invisible" data-theme="dark" data-sitekey="6LfCB14lAAAAAGBpaW5w4hgPn25G42lSN4t3aFhv" data-action='submit' data-callback="onSubmit") Отправить заявку

