-
  var tasks_data = [
  {
    "title": "Кейс от Института ИТ,",
    "org1": "VK Education,",
    "org2": "VK Play и",
    "org3": "RuStore",
    "description": "Разработка игры для мобильного устройства с операционной системой Android.",
    "radioId": "task1"
  }]

mixin task(data)
  article.task
    div
      h3.title= data.title
      h3.title=data.org1
      h3.title=data.org2
      h3.title=data.org3
      p.description
        = data.description
    div
      label(for=data.radioId)
        span.button.taskButton Выбрать кейс

section.tasks#tasks-section
  h2.tasks__header Задача
  .tasks__content
    each singleTask in tasks_data
      +task(singleTask)
